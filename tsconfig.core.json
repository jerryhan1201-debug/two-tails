{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "tests/access.test.ts",
    "tests/broom-speed-effects.test.ts",
    "tests/camera-ray-index.test.ts",
    "tests/home-fixed-light.test.ts",
    "tests/home-frame-diagnostics.test.ts",
    "tests/material-light-budget.test.ts",
    "tests/night-lighting.test.ts",
    "tests/render-candidates.test.ts",
    "tests/render-resolution.test.ts",
    "tests/resource-cost.test.ts",
    "tests/weather.test.ts"
  ],
  "exclude": []
}
