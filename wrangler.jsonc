{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "two-tails",
  "main": "server/worker.ts",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "ADVENTURES", "class_name": "AdventureService" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AdventureService"] }],
  "observability": { "enabled": false }
}
